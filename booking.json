{
  "client": "Thunder Client",
  "collectionName": "Medical Booking System API",
  "requests": [
    {
      "name": "Register User",
      "url": "http://localhost:3000/user",
      "method": "POST",
      "body": {
        "type": "json",
        "raw": "{\n  \"fullName\": \"Ahmad Patient\",\n  \"email\": \"ahmad@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"patient\"\n}"
      }
    },
    {
      "name": "Get All Users",
      "url": "http://localhost:3000/user",
      "method": "GET"
    },
    {
      "name": "Login User",
      "url": "http://localhost:3000/auth/login",
      "method": "POST",
      "body": {
        "type": "json",
        "raw": "{\n  \"email\": \"ahmad@example.com\",\n  \"password\": \"password123\"\n}"
      }
    },
    {
      "name": "Create Doctor Profile",
      "url": "http://localhost:3000/doctor",
      "method": "POST",
      "body": {
        "type": "json",
        "raw": "{\n  \"userId\": 2,\n  \"specialization\": \"Cardiology\",\n  \"consultationFee\": \"100$\"\n}"
      }
    },
    {
      "name": "Get All Doctors",
      "url": "http://localhost:3000/doctor",
      "method": "GET"
    },
    {
      "name": "Create Booking",
      "url": "http://localhost:3000/booking",
      "method": "POST",
      "body": {
        "type": "json",
        "raw": "{\n  \"doctorId\": 1,\n  \"patientId\": 1,\n  \"appointmentDate\": \"2026-09-15T11:00:00.000Z\"\n}"
      }
    },
    {
      "name": "Get All Bookings",
      "url": "http://localhost:3000/booking",
      "method": "GET"
    }
  ]
}